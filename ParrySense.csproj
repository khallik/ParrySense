<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ParrySense</AssemblyName>
    <Product>ParrySense</Product>
    <RootNamespace>ParrySense</RootNamespace>
    <Version>0.1.0</Version>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <!--
      Local development paths.
      Define these as environment variables or MSBuild properties:
        VALHEIM_MANAGED_PATH = ...\Valheim\valheim_Data\Managed
        BEPINEX_CORE_PATH     = ...\BepInEx\core

      No user-specific absolute paths are committed to the repository.
    -->
    <ValheimManagedPath Condition="'$(ValheimManagedPath)' == ''">$(VALHEIM_MANAGED_PATH)</ValheimManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">$(BEPINEX_CORE_PATH)</BepInExCorePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers"
                      Version="1.*"
                      PrivateAssets="all" />

    <PackageReference Include="BepInEx.Core"
                      Version="5.*" />

    <PackageReference Include="BepInEx.PluginInfoProps"
                      Version="2.*" />

    <PackageReference Include="UnityEngine.Modules"
                      Version="6000.0.7"
                      IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- Valheim -->
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManagedPath)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Harmony supplied by the local BepInExPack installation -->
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ValheimManagedPath)' == ''"
           Text="VALHEIM_MANAGED_PATH (or MSBuild property ValheimManagedPath) is not set." />
    <Error Condition="'$(BepInExCorePath)' == ''"
           Text="BEPINEX_CORE_PATH (or MSBuild property BepInExCorePath) is not set." />
    <Error Condition="!Exists('$(ValheimManagedPath)\assembly_valheim.dll')"
           Text="assembly_valheim.dll was not found at '$(ValheimManagedPath)\assembly_valheim.dll'." />
    <Error Condition="!Exists('$(BepInExCorePath)\0Harmony.dll')"
           Text="0Harmony.dll was not found at '$(BepInExCorePath)\0Harmony.dll'." />
  </Target>

</Project>
